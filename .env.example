# 主编码模型使用 Anthropic 消息接口，也支持提供兼容接口的服务。
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
MODEL_ID=

# 规范选择使用 LLM；正式验收默认让 Jev 检查全部变更、规范、架构和任务目标。
RULE_SELECTOR=llm
SELECTOR_MODEL_ID=
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-1.13.0
REVIEW_MODEL_ID=deepseek-flash
REVIEW_MODE=jev_first
JEV_REVIEW_MIN_CONFIDENCE=0.95
# 可选 GitLab MR 入口，仅对配置的主机传递令牌。
GITLAB_BASE_URL=https://gitlab.com
GITLAB_API_TOKEN=
